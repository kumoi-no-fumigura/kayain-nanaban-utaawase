 "poems": [
  {
   "seq": "1",
   "text": "山櫻にほふあたりの春かすみ風をはよそにたちへたてなむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春かせは吹とも散なさくら花はなの心をわれになしつゝ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "紅のうす花さくらにほはすはみなしら雲とみてや過まし",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "しら雲とみゆるにしるしみよしのゝよし野の山は花盛かも",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山櫻惜むこゝろの幾度かちるこのもとに行かへるらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "花ゆへにかゝらぬ山そなかりける心ははるの霞ならねと",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "八千代へんやとに匂へる八重櫻やそ氏人もちらてこそみめ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "風の音のゝとけき春の宿なれは匂ふ櫻をあくまてそみる",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "朝またき霞なこめそ山櫻たつねゆくまのよそめにもみん",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "おもふ事露たになきは山櫻はなみる程のこゝろ也けり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "たつねくる心もしるく山櫻いまこそ花の盛なりけり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山櫻にほふ盛に風ふけはあたりの松も花さきにけり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ちりつもる庭をそみまし山櫻かせより先にたつねさりせは",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "山櫻咲そめしより久かたの雲ゐにみゆる瀧のしら糸",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "五月雨のはれぬそらにも郭公こゑはさやかに鳴わたるかな",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "郭公こゝろのまゝにたつねつゝ生田の森に一聲そきく",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "山ちかくうらこく舟は郭公鳴わたりこそとまり也けり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "子規雲ゐはるかになのれはやあさくら山のよそに鳴らん",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "よをかさねまちかれ山の郭公雲のよそにて一聲そきく",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "あくるまてまちかね山の郭公けふもきかすやくれんとすらん",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "郭公なつのよな〓〓まち〓〓て去年もことしも一聲そきく",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "きゝつともいかゝ語らむ郭公おほつかなしやよはの一聲",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "きゝてしも猶そまたるゝ子規なく一こゑにあかぬ心は",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ほとゝきす音信しより音羽山ふもとの里をかれすとふ哉",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ほとゝきす雲井のこゑを聞人は心さへこそ空になりけれ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "郭公いまそ鳴なるとなりにも吹つる笛そ音にをとゝめて",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "夢かとそおとろかれぬる子規またも音せぬよはの一聲",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "まちかねてぬるよもあらは郭公あかぬ例の名をやたゝまし",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "曇りなき雲のうへまて照月はいとゝ光をみかくなりけり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "月みれはひるとそ思ふ秋のよをなかき春日と思ひなしつゝ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "君みると空にしれはや秋の月くもらぬかけのよゝにすむらん",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "あふ坂のせきの杉原下はれて月のもるにそ任せたりける",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "常よりもみかさの山の月影はひかりさしそふ天の下かな",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "岩橋の神のちきれるかひもなしくまなく照す秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "秋のよはいとゝなかくそ成ぬへき明るもしらぬ月の光に",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "常磐山した葉の露のかすことに影さしそふる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "ふみゝける鳩のあとさへ惜きかな氷のうへにふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "みかりのはかつふる雪に埋れてとたちも見えす草かくれつゝ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "雪もみな降かひありて積れはやしら雲かゝる山とみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "と山には柴の下葉も散はてゝ遠の高ねに雪降にけり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "近江路はたみの笠のみゝゆる哉こしにもまさる雪にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "旅人のねすりの衣うちはらひはらひもあへすけさのはつ雪",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "あまの原空かきくらし降雪に思ひこそやれみよしのゝ山",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "雪ふれは野原を行も分やらすかやか下折いとゝしみたれ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "鏡山みねよりいつる月なれは曇るよもなき影をゝそみれ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "水ならて人にも月や移るらんみれは心のすみわたる哉",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "曇りなき玉のうてなのみかけるに光をそふる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "秋のよの月に心のひまそなきいつるをまつといるを惜むと",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "照月の光さえゆく宿なれは秋の水にもつらゝゐにけり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "山のはに雲のころもをぬきすてゝひとりや月の立のほるらん",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "岩代のむすへる松にふる雪は春もとけすやあらんとすらん",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "押なべて山のしら雪つもれともしるきは越の高根也けり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "遠近の峯のつゝきもみえぬまてあまきる雪も降しきにけり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "衣手に淀のうら風さえ〓〓〓てたなかみ山に雪ふりにけり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "降ゆきに杉の靑葉も埋れてしるしもみえぬみわの山本",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ふる雪に谷のかけはし埋れて梢そ冬の山ちなりける",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "きみか代は萬代まてにさしてけりみかさの山の神の惠に",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "君かよの天のこやねのみことより祝ひそゝめし久しかれとは",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "萬代を又よろつよを增鏡かけをならへてしるそ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "もゝとせをかさね〓〓て君か代はつきしとそ思ふ萬よまてに",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "千代ふへき君を守れはみかさ山神の心ものとけかるらん",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "おちたきる八十字治川の早きせに岩こす波は千代のかすかも",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "君か代はまさこのかすもあかすして瀨々の千鳥も猶そふる哉",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "君か代はくもりもあらし三笠山みねの朝ひのさゝん限りは",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "きみか代は龜のお山に住鶴の毛衣さへや千代を重ねん",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "君が代は長抦の濵のさゝれ石のいはれの山になりはつるまて",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "萬代といのりそつむる君か代は山田の原の下つ岩ねに",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "君か代はかねてそしるき春日山二葉の松の神さふるまて",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "よろつよを松の尾山の陰しけみ君をそいのる常磐かきはに",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あめの下ひさしきみ代のしるしにはみかさの山の榊をそさす",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
